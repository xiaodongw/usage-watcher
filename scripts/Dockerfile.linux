# The Linux release build, pinned to an old distribution on purpose.
#
# glibc symbol versioning is backward compatible and not forward: a binary
# linked against 2.35 runs on 2.39, and one linked against 2.39 will not start
# on 2.35 at all. So the build host, not the target, decides how many people can
# run the result. Building natively on 26.04 set that floor at 2.39, which
# excluded Debian 12 — the current stable release — along with every LTS older
# than Ubuntu 24.04.
#
# 22.04 is the oldest base that works, and the limit is not glibc but WebKit.
# Tauri v2 needs webkit2gtk **4.1**, the libsoup3 flavour; jammy carries it as a
# backport (2.50.4 at the time of writing). 20.04 would be worth another four
# years of compatibility — glibc 2.31, which would reach Debian 11 and RHEL 9 —
# but it has no 4.1 at all, only 4.0 at 2.38.6, and Tauri v2 cannot use 4.0.
# Checked, not assumed:
#
#     docker run --rm ubuntu:20.04 sh -c \
#       'apt-get update -qq; apt-cache policy libwebkit2gtk-4.1-dev'
#
# What comes out is better than the base suggests. The floor is set by the
# newest symbol actually referenced, not by the glibc that was present at build
# time, and these binaries reach back to **2.34** — so RHEL 9, Rocky 9 and
# AlmaLinux 9 are in range after all, along with Debian 12 and every Ubuntu LTS
# from 22.04. Re-measure after a dependency bump rather than trusting this
# number:
#
#     objdump -T usage-watcher | grep -oE 'GLIBC_[0-9.]+' | sort -uV | tail -1
#
# glibc is only half the question for the GUI, which additionally needs
# webkit2gtk-4.1 present at run time; a distribution carrying only 4.0 can run
# `uw` and `uwd` but not the app. Those two link no GUI library at all.
#
# Nothing here affects GNOME. The extension is plain GJS whose schema is
# compiled on the user's machine by its own installer, and the app's tray
# library is dlopened at runtime rather than linked, so both bind to whatever
# the user actually has. WebKit and GTK are linked by soname, which is stable.
FROM ubuntu:22.04

ARG DEBIAN_FRONTEND=noninteractive
# Pinned rather than "lts": a release build should not change because a
# mirror moved on.
ARG NODE_VERSION=20.18.1
# Matches the host this was developed on, so the released binary comes out of
# the same compiler the code was tested with. It is not a free choice: the
# dependency tree needs at least 1.89 — `zbus`, `time-macros` and friends say so
# — even though `Cargo.toml` still claims `rust-version = "1.82"`.
ARG RUST_VERSION=1.97.1

RUN apt-get update && apt-get install -y --no-install-recommends \
      build-essential pkg-config ca-certificates curl xz-utils zip git \
      libwebkit2gtk-4.1-dev libgtk-3-dev libayatana-appindicator3-dev \
      libglib2.0-dev libdbus-1-dev \
    && rm -rf /var/lib/apt/lists/*

RUN curl -fsSL "https://nodejs.org/dist/v${NODE_VERSION}/node-v${NODE_VERSION}-linux-x64.tar.xz" \
    | tar -xJ -C /usr/local --strip-components=1

# `CARGO_HOME` is overridden at run time to a mounted cache, so only the
# toolchain itself lives in the image. `PATH` still finds the shims here.
ENV RUSTUP_HOME=/opt/rustup \
    CARGO_HOME=/opt/cargo \
    PATH=/opt/cargo/bin:$PATH
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs \
    | sh -s -- -y --profile minimal --default-toolchain "${RUST_VERSION}" \
    && chmod -R a+rX /opt/cargo /opt/rustup

# The container runs as the invoking user so that everything it writes into the
# mounted checkout belongs to them rather than to root. That user has no passwd
# entry, which several tools take badly unless HOME points somewhere writable —
# the runner supplies one.
WORKDIR /work
