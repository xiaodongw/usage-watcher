# Where uwd is listening. The default matches uwd's own default, so this file
# is only needed when the daemon runs elsewhere — e.g. pointing a Windows-side
# widget at a daemon inside WSL, or reaching one over Tailscale.
VITE_UWD_URL=http://127.0.0.1:7878

# Required only when uwd is bound to a non-loopback address, which it refuses
# to do without a token.
# VITE_UWD_TOKEN=
